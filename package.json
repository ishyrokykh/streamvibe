{
  "name": "minista-project",
  "private": true,
  "scripts": {
    "dev": "minista --config minista.dev.config.ts",
    "build": "minista --config minista.prod.config.ts build && npm run css:optimize",
    "preview": "minista --config minista.prod.config.ts preview",
    "css:optimize": "postcss dist/assets/bundle.css -o dist/assets/bundle.css --use mqpacker",
    "deploy": "gh-pages -d dist"
  },
  "prettier": {
    "semi": false
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/postcss-pxtorem": "^6.1.0",
    "@types/react": "^18.2.16",
    "@types/react-dom": "^18.2.7",
    "gh-pages": "^6.3.0",
    "minista": "^3.1.12",
    "mqpacker": "^7.0.0",
    "postcss-cli": "^11.0.1",
    "postcss-preset-env": "^10.2.4",
    "postcss-pxtorem": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.81.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@a1rth/css-normalize": "^1.1.9",
    "classnames": "^2.5.1",
    "imask": "^7.6.1",
    "swiper": "^11.2.4"
  }
}
